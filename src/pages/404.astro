---
/**
 * Not-found page. Cloudflare Pages serves dist/404.html for unknown paths.
 * Kept out of search results with noindex.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { person } from '../content/site';
---

<BaseLayout title={`Page not found | ${person.name}`} noindex>
  <main id="main" class="not-found">
    <div class="container not-found__inner">
      <h1>Page not found</h1>
      <p>The page you are looking for does not exist.</p>
      <a class="button button--primary" href="/">Go to the home page</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    place-items: center;
    background: var(--color-mint);
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block: 4rem;
  }

  .not-found h1 {
    font-size: var(--text-h2);
    font-weight: 800;
  }
</style>
