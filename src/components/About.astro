---
/**
 * About section: the bio and a supporting photo.
 */
import { Picture } from 'astro:assets';
import { person, photos } from '../content/site';
import aboutPhoto from '../assets/alex-rivera-online.jpg';
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container about__inner">
    <h2 id="about-title" class="section-title about__title reveal">About</h2>
    <div class="about__body">
      <p class="about__bio reveal">{person.bio}</p>
      <figure class="about__media reveal" style="--reveal-delay: 0.1s">
        <Picture
          src={aboutPhoto}
          alt={photos.about.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 64rem) 44rem, 92vw"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 52rem) {
    .about__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
      gap: 4rem;
    }
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .about__bio {
    max-width: 40em;
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .about__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: var(--radius);
  }
</style>
