---
/**
 * Top section: name (the page's only h1), title and photo.
 * The photo is the largest element on first paint, so it loads eagerly
 * with high fetch priority, in responsive AVIF/WebP sizes.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { person, photos } from '../content/site';
import heroPhoto from '../assets/alex-rivera-workshop.jpg';
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__name reveal">{person.name}</h1>
      <p class="hero__title reveal" style="--reveal-delay: 0.1s">{person.jobTitle}</p>
      <p class="hero__location reveal" style="--reveal-delay: 0.15s">
        {person.locality}, {person.countryName}
      </p>
      <p class="hero__actions reveal" style="--reveal-delay: 0.2s">
        <a class="button button--primary" href="#courses">
          View courses
          <Icon name="arrow" class="icon-arrow" />
        </a>
        <a class="hero__contact" href="#contact">Contact</a>
      </p>
    </div>

    <figure class="hero__media reveal" style="--reveal-delay: 0.1s">
      <Picture
        src={heroPhoto}
        alt={photos.hero.alt}
        formats={['avif', 'webp']}
        widths={[400, 640, 960, 1280]}
        sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 60vw, 92vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-tint);
    border-bottom: 1px solid var(--color-line);
  }

  .hero__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 4.5rem;
    }
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero__name {
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .hero__title {
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-ink);
  }

  .hero__location {
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 1rem;
  }

  .hero__contact {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .hero__media {
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }

  .hero__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius);
  }
</style>
