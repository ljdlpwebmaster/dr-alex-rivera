---
/**
 * One course card: a coloured header band with the title, then the
 * description, length and link. Rendered as an <article> so it stands on
 * its own. The link text gets a visually hidden course name, so screen
 * reader users hear which course each link is for.
 */
import Icon from './Icon.astro';
import type { Course } from '../content/site';

interface Props {
  course: Course;
  /** Position in the list, used to pick the band colour. */
  index: number;
}

const { course, index } = Astro.props;
const headingId = `${course.id}-title`;
const tones = ['teal', 'green', 'apricot'] as const;
const tone = tones[index % tones.length];
---

<article id={course.id} class:list={['course', `course--${tone}`]} aria-labelledby={headingId}>
  <div class="course__band">
    <span class="course__shape course__shape--a" aria-hidden="true"></span>
    <span class="course__shape course__shape--b" aria-hidden="true"></span>
    <h3 id={headingId} class="course__title">{course.name}</h3>
  </div>
  <div class="course__body">
    <p class="course__description">{course.description}</p>
    <dl class="course__meta">
      <dt class="visually-hidden">Length</dt>
      <dd>
        <Icon name="clock" size={16} />
        {course.length}
      </dd>
    </dl>
    <a class="button course__link" href={course.href}>
      Course details<span class="visually-hidden">: {course.name}</span>
      <Icon name="arrow" class="icon-arrow" />
    </a>
  </div>
</article>

<style>
  .course {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .course:hover,
  .course:focus-within {
    transform: translateY(-6px);
    border-color: var(--color-accent);
    box-shadow: 0 24px 48px -28px rgb(20 33 31 / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .course:hover,
    .course:focus-within {
      transform: none;
    }
  }

  .course__band {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 9.5rem;
    padding: 1.75rem 1.625rem;
    overflow: hidden;
  }

  .course--teal .course__band {
    background: var(--color-accent);
    --band-text: var(--color-surface);
  }

  .course--green .course__band {
    background: var(--color-accent-mid);
    --band-text: var(--color-surface);
  }

  .course--apricot .course__band {
    background: var(--color-apricot);
    --band-text: var(--color-ink);
  }

  /* Soft decorative circles in each band. */
  .course__shape {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .course__shape--a {
    width: 11rem;
    top: -5rem;
    right: -3rem;
  }

  .course__shape--b {
    width: 7rem;
    bottom: -3.5rem;
    left: -2rem;
  }

  .course__title {
    position: relative;
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--band-text);
  }

  .course__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.125rem;
    padding: 1.5rem 1.625rem 1.625rem;
  }

  .course__description {
    flex-grow: 1;
  }

  .course__meta {
    font-size: 0.875rem;
    color: var(--color-ink);
  }

  .course__meta dd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .course__link {
    width: 100%;
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
  }

  .course__link:hover {
    background: var(--color-accent);
    color: var(--color-surface);
  }
</style>
