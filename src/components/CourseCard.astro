---
/**
 * One course, laid out as a row: title, description, length and link.
 * Rendered as an <article> so it stands on its own. The link text gets a
 * visually hidden course name, so screen reader users hear which course
 * each link is for.
 */
import Icon from './Icon.astro';
import type { Course } from '../content/site';

interface Props {
  course: Course;
}

const { course } = Astro.props;
const headingId = `${course.id}-title`;
---

<article id={course.id} class="course" aria-labelledby={headingId}>
  <h3 id={headingId} class="course__title">{course.name}</h3>
  <p class="course__description">{course.description}</p>
  <dl class="course__meta">
    <dt>Length</dt>
    <dd>{course.length}</dd>
  </dl>
  <a class="course__link" href={course.href}>
    Course details<span class="visually-hidden">: {course.name}</span>
    <Icon name="arrow" class="icon-arrow" />
  </a>
</article>

<style>
  .course {
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 56rem) {
    .course {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.4fr) minmax(0, 0.8fr) auto;
      gap: 2.5rem;
      align-items: baseline;
    }
  }

  .course__title {
    font-size: var(--text-h3);
    line-height: 1.25;
  }

  .course__description {
    color: var(--color-text);
  }

  .course__meta {
    font-size: var(--text-sm);
  }

  .course__meta dt {
    color: var(--color-muted);
  }

  .course__meta dd {
    font-weight: 600;
    color: var(--color-ink);
  }

  .course__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    justify-self: start;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
