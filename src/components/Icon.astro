---
/**
 * Small inline SVG icon set. Icons are decorative (aria-hidden), so the
 * text next to them always carries the meaning.
 */
interface Props {
  name: 'arrow';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const paths = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6" />',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
