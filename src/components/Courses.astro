---
/**
 * Courses section: one CourseCard per course in the content model.
 */
import CourseCard from './CourseCard.astro';
import { courses } from '../content/site';
---

<section id="courses" class="section courses" aria-labelledby="courses-title">
  <div class="container">
    <h2 id="courses-title" class="section-title courses__title reveal">Courses</h2>
    <ul class="courses__list" role="list">
      {
        courses.map((course, index) => (
          <li class="reveal" style={`--reveal-delay: ${index * 0.1}s`}>
            <CourseCard course={course} index={index} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .courses {
    background: var(--color-tint);
  }

  .courses__title {
    margin-bottom: 2.5rem;
  }

  .courses__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17.5rem, 100%), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
