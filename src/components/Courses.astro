---
/**
 * Courses section: one row per course in the content model, mirroring the
 * table the courses were supplied in.
 */
import CourseCard from './CourseCard.astro';
import { courses } from '../content/site';
---

<section id="courses" class="section courses" aria-labelledby="courses-title">
  <div class="container">
    <h2 id="courses-title" class="section-title courses__title reveal">Courses</h2>
    <ul class="courses__list" role="list">
      {
        courses.map((course, index) => (
          <li class="reveal" style={`--reveal-delay: ${index * 0.08}s`}>
            <CourseCard course={course} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .courses {
    background: var(--color-tint);
    border-block: 1px solid var(--color-line);
  }

  .courses__title {
    margin-bottom: 2rem;
  }

  .courses__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-line);
  }
</style>
