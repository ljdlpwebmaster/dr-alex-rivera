---
/**
 * Contact section: her email as a mailto link. No form, by design: the
 * brief asks only for the email, and a form would need a back end.
 */
import { person } from '../content/site';

// Allow a line break only after the @ on very narrow screens, never mid-word.
const [emailUser, emailDomain] = person.email.split('@');
---

<section id="contact" class="contact on-dark" aria-labelledby="contact-title">
  <div class="container contact__outer">
    <div class="contact__panel reveal">
      <p class="section-label" aria-hidden="true">03</p>
      <h2 id="contact-title" class="section-title">Contact</h2>
      <p class="contact__email">
        <span class="contact__email-label">Email</span>
        <a class="contact__email-link" href={`mailto:${person.email}`}>
          {emailUser}@<wbr />{emailDomain}
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .contact__outer {
    padding-bottom: var(--section-space);
  }

  .contact__panel {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding: clamp(1.75rem, 0.5rem + 5vw, 5rem);
    border-radius: var(--radius-lg);
    background: var(--color-teal);
  }

  .contact__panel::after {
    content: '';
    position: absolute;
    right: -7rem;
    bottom: -9.5rem;
    width: 22.5rem;
    height: 22.5rem;
    border-radius: 50%;
    background: var(--color-apricot);
    opacity: 0.16;
    pointer-events: none;
  }

  .contact__email {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }

  .contact__email-label {
    font-size: 0.9375rem;
    color: var(--color-on-dark-muted);
  }

  .contact__email-link {
    align-self: flex-start;
    padding-inline: 0.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 0.6rem + 4.4vw, 4rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-surface);
    text-decoration: none;
    background-image: linear-gradient(var(--color-apricot), var(--color-apricot));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 3px;
    transition:
      background-size 0.35s ease,
      color 0.35s ease;
  }

  .contact__email-link:hover {
    color: var(--color-ink);
    background-size: 100% 100%;
  }
</style>
