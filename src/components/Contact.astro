---
/**
 * Contact section: her email as a mailto link. No form, by design: the
 * brief asks only for the email, and a form would need a back end.
 */
import { person } from '../content/site';

// Allow a line break only after the @ on very narrow screens, never mid-word.
const [emailUser, emailDomain] = person.email.split('@');
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <h2 id="contact-title" class="section-title reveal">Contact</h2>
    <dl class="contact__details reveal" style="--reveal-delay: 0.1s">
      <dt>Email</dt>
      <dd>
        <a class="contact__email" href={`mailto:${person.email}`}>
          {emailUser}@<wbr />{emailDomain}
        </a>
      </dd>
    </dl>
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 52rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
      gap: 4rem;
      align-items: baseline;
    }
  }

  .contact__details dt {
    margin-bottom: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .contact__email {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.1rem + 2.4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
</style>
