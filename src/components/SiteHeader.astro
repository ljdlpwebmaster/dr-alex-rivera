---
/**
 * Sticky site header: home link and in-page navigation.
 * Three short links fit on any phone, so no JavaScript menu is needed.
 */
import { navigation, person } from '../content/site';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="#top">
      <span class="brand__mark" aria-hidden="true">AR</span>
      <span class="brand__name">{person.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          navigation.map((item) => (
            <li>
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(232 241 238 / 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    min-height: var(--header-height);
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-ink);
  }

  .brand__mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.7rem;
    background: var(--color-teal);
    color: var(--color-surface);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
  }

  .brand__mark::after {
    content: '';
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-apricot);
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding: 0.625rem 0.75rem;
    color: var(--color-ink-soft);
    font-weight: 500;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0.75rem calc(100% - 0.375rem);
    background-size: 0% 2px;
    transition: background-size 0.3s ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
    background-size: calc(100% - 1.5rem) 2px;
  }
</style>
