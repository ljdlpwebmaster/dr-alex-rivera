---
/**
 * Sticky site header: logo (home link) and in-page navigation.
 * Three short links fit on any phone, so no JavaScript menu is needed.
 */
import { navigation, person } from '../content/site';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="#top">
      <span class="brand__mark" aria-hidden="true">AR</span>
      <span class="brand__name">{person.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="site-header__nav">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.94);
    border-bottom: 1px solid var(--color-line);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: rgb(255 255 255 / 0.82);
      backdrop-filter: blur(12px);
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    min-height: var(--header-height);
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-ink);
  }

  .brand__mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 0.625rem;
    background: var(--color-accent);
    color: var(--color-surface);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* Apricot dot, matching the favicon. */
  .brand__mark::after {
    content: '';
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--color-apricot);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -0.75rem;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-header__nav a:hover {
    color: var(--color-accent);
  }
</style>
