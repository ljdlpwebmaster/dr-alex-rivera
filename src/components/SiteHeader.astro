---
/**
 * Sticky site header: home link and in-page navigation.
 * Three short links fit on any phone, so no JavaScript menu is needed.
 */
import { navigation, person } from '../content/site';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href="#top">{person.name}</a>
    <nav aria-label="Main">
      <ul class="site-header__nav">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.94);
    border-bottom: 1px solid var(--color-line);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: rgb(255 255 255 / 0.8);
      backdrop-filter: blur(12px);
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    min-height: var(--header-height);
    padding-block: 0.5rem;
  }

  .site-header__name {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    margin: 0 -0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
  }

  .site-header__nav a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  @media (max-width: 30rem) {
    .site-header__nav {
      margin-left: -0.75rem;
    }
  }
</style>
